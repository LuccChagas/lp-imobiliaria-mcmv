# URL publica do site. Em producao na Vercel pode deixar vazio — o codigo
# resolve sozinho pela variavel de projeto da Vercel.
NEXT_PUBLIC_SITE_URL=

# Webhook que recebe o lead. Cole aqui a URL /exec do Apps Script
# (instrucoes em scripts/planilha-apps-script.gs).
LEAD_WEBHOOK_URL=

# Mesma senha que voce colocou na constante TOKEN do Apps Script.
LEAD_WEBHOOK_TOKEN=

# Rastreamento. Cada bloco so e injetado se o ID existir — a pagina
# funciona normalmente com tudo vazio.
NEXT_PUBLIC_META_PIXEL_ID=
NEXT_PUBLIC_GA4_ID=
NEXT_PUBLIC_GTM_ID=
